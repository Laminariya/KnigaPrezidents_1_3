  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Asosiy tamoyillar\nYangi O\u02BBzbekistonning tashqi siyosati xalq va
    Vatan manfaatlarini har tomonlama hisobga olgan holda amalga oshirilmoqda. Mamlakat
    mudofaa qobiliyatini va Qurolli Kuchlar salohiyatini mustahkamlash chegaralar
    daxlsizligining, jamiyatda xavfsizlik va barqarorlikning, xalqning tinch hayoti
    uchun eng muhim shart hisoblanadi.\n\nHarbiy doktrina\nHarbiy doktrina harbiy
    siyosatning mudofaa xususiyatiga asoslanadi va hujumchi harbiy bloklarda ishtirok
    etishni rad etadi. Tashqi siyosatning tinchlik tamoyillarini saqlagan holda armiyani
    professionallashtirish, harbiy ta'limni takomillashtirish va zamonaviy texnologiyalarni
    joriy etish amalga oshirilmoqda.\n\nHududiy siyosat\nMarkaziy Osiyo mamlakatlari
    bilan munosabatlarni qurish strategiyasi yaxshi qo'shnichilik, suverenitetni
    o'zaro hurmat qilish, ichki ishlarga aralashmaslik va nizolarni tinch yo'l bilan
    hal etish tamoyillariga asoslangan. O\u02BBzbekiston mintaqaviy integratsiya
    va savdo-iqtisodiy aloqalarni rivojlantirishning lokomotivi bo\u02BBlib xizmat
    qilmoqda.\n\nKo\u02BBp vektorli diplomatiya\nDunyoning barcha yirik davlatlari
    bilan teng huquqli munosabatlarni rivojlantirish bo'yicha muvozanatli siyosat
    olib borilmoqda. BMT, ShHT, MDH, IHT va boshqa xalqaro tashkilotlar faoliyatida
    ishtirok etish faol rivojlanmoqda.\n\nZamonaviy xavfsizlik tahdidlari\nTerrorizm
    va ekstremizmga qarshi kurashish, oldini olish chora-tadbirlari, ta'lim dasturlari
    va xalqaro hamkorlik orqali kurashishga alohida e'tibor qaratilmoqda. Kiberxavfsizlik
    va transchegaraviy ekologik muammolarni hal qilish bo'yicha milliy salohiyat
    rivojlanmoqda.\n\nIqtisodiy diplomatiya\nDiplomatik resurslar mamlakatning investitsiyaviy
    salohiyatini rivojlantirish, xalqaro miqyosda munosib imij yaratish va savdo-iqtisodiy
    aloqalarni rivojlantirish uchun ishlatiladi. Tashqi savdo aloqalarini diversifikatsiya
    qilish va yangi bozorlarni topish uchun alohida e'tibor qaratilmoqda.\n\nGumanitar
    diplomatiya\nMadaniy markazlar tashkil etish, sayyohlik salohiyatini rivojlantirish
    va xalqaro madaniy tadbirlar orqali o'zbek madaniyati va tilini dunyoda faol
    targ'ib qilmoqda. Akademik mobillik dasturlari va qo'shma ta'lim muassasalarini
    tashkil etish rivojlanmoqda.\n\nTinchlik tashabbuslari\nO'zbekiston mintaqada
    muzokaralar o'tkazish va insonparvarlik yordami ko'rsatish orqali tinchlikparvar
    sifatida ish olib bormoqda. Mamlakat qurolsizlanish, ommaviy qirg'in qurollaridan
    xoli hududlar va qurollarning tarqalishini nazorat qilish bo'yicha xalqaro sa'y-harakatlarni
    qo'llab-quvvatlaydi.\n\n"
  m_isRightToLeft: 0
