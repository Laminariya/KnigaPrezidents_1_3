  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u0434\u0430\u043D\u043D\u043E\u0439 \u0433\u043B\u0430\u0432\u0435
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u043E, \u0447\u0442\u043E \u0432 \u041D\u043E\u0432\u043E\u043C
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
    \u043F\u043E\u043E\u0449\u0440\u0435\u043D\u0438\u044F, \u0437\u0430\u0449\u0438\u0442\u044B
    \u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u043F\u0440\u0430\u0432
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430 \xAB\u0413\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
    \u0434\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430\xBB \u0441\u0442\u0430\u043B\u0438
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u044B\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u0440\u0435\u0444\u043E\u0440\u043C.\n\u0422\u0430\u043A\u0436\u0435 \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u044D\u0442\u043E \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u043E\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E
    \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u0435 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0442\u0440\u0430\u043D\u044B, \u043D\u043E
    \u0438 \u0432\u043E \u0432\u0441\u0435\u043C \u043C\u0438\u0440\u0435\L\u043A\u0430\u043A
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0435
    \u0441\u0430\u043C\u044B\u043C \u0434\u0435\u043C\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u043C,\L\u0438 \u0447\u0442\u043E
    \u043A\u043E\u043D\u0435\u0447\u043D\u0430\u044F \u0446\u0435\u043B\u044C \u0440\u0435\u0444\u043E\u0440\u043C
    \u2014 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E\L\u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u0430
    \u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432, \u043F\u0440\u0430\u0432
    \u0438 \u0441\u0432\u043E\u0431\u043E\u0434."
