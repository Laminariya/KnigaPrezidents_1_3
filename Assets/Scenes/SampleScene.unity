--- !u!114 &1398524641
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1398524637}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3e34b07c94be9c48bdc24e93935fffe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textJuicer: {fileID: 0}
  textList:
  - "Kitobning muqaddima qismida Yangi O\u02BBzbekiston orzusi, uni barpo etish \u2013
    bu shunchaki xohish-istak, subyektiv hodisa emas, balki tub tarixiy asoslarga
    ega bo\u2018lgan, mamlakatimizda mavjud siyosiy-huquqiy, ijtimoiy-iqtisodiy,
    ma`naviy-ma`rifiy vaziyatning o\u2018zi taqozo etayotgan, xalqimizning asriy
    orzu-intilishlariga mos, uning milliy manfaatlariga to\u2018la javob beradigan
    obyektiv zarurat ekani\_ bayon etilgan."
  - "\u0412\u043E\_\u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043A\_\u043A\u043D\u0438\u0433\u0435
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u043E, \u0447\u0442\u043E\_\u043C\u0435\u0447\u0442\u0430
    \u043E\_\u041D\u043E\u0432\u043E\u043C \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0435
    \u0438\_\u0435\u0451\_\u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435
    \u0432\_\u0436\u0438\u0437\u043D\u044C\_\u2014 \u044D\u0442\u043E\_\u043D\u0435\_\u043F\u0440\u043E\u0441\u0442\u043E
    \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0438\u043B\u0438\_\u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u044F\u0432\u043B\u0435\u043D\u0438\u0435, \u0430\_\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C,
    \u0438\u043C\u0435\u044E\u0449\u0430\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u0441\u043D\u043E\u0432\u044B,
    \u0434\u0438\u043A\u0442\u0443\u0435\u043C\u0430\u044F \u0441\u0430\u043C\u043E\u0439
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0432\_\u043D\u0430\u0448\u0435\u0439
    \u0441\u0442\u0440\u0430\u043D\u0435 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E-\u043F\u0440\u0430\u0432\u043E\u0432\u043E\u0439,
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439,
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F
    \u0432\u0435\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0447\u0442\u0430\u043C
    \u0438\_\u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u044F\u043C \u043D\u0430\u0448\u0435\u0433\u043E
    \u043D\u0430\u0440\u043E\u0434\u0430, \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0449\u0430\u044F \u0435\u0433\u043E\_\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u043C."
--- !u!114 &1398524642
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1398524637}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u044D\u0442\u043E\u043C \u0440\u0430\u0437\u0434\u0435\u043B\u0435
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0441\u044F \u043E \u0442\u043E\u043C,
    \u0447\u0442\u043E \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u041D\u043E\u0432\u043E\u0433\u043E \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430
    \u0441\u043B\u0443\u0436\u0438\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0449\u0435\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044E \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u2014
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043D\u043E\u0432\u043E\u0433\u043E
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439.\n\u0422\u0430\u043A\u0436\u0435
    \u0432 \u0440\u0430\u0437\u0434\u0435\u043B\u0435 \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u044B
    \u0438\u0434\u0435\u0438, \u0430\u043D\u0430\u043B\u0438\u0437\u044B, \u0440\u0435\u0444\u043E\u0440\u043C\u044B
    \u0438 \u043F\u043B\u0430\u043D\u044B, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044E \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0438
    \u0441 \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C \u043D\u0430 \u0431\u043B\u0430\u0433\u0438\u0435
    \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u0438 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u044F
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
    \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0435\u043C\u044C\u0438 \u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439
    \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0449\u0435\u0439
    \u0436\u0438\u0437\u043D\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435 \u043D\u0430
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0439 \u0440\u043E\u0441\u0442
    \u0443\u0440\u043E\u0432\u043D\u044F \u0436\u0438\u0437\u043D\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F
    \u043A\u0430\u043A \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442.\n"
