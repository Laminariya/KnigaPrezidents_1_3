  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 263935557}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u0434\u0430\u043D\u043D\u043E\u0439 \u0433\u043B\u0430\u0432\u0435
    \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0441\u044F \u043E \u0442\u043E\u043C,
    \u0447\u0442\u043E \u0432 \u043C\u0438\u0440\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430
    \u0435\u0441\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0438\u0439 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A
    \u2014 \u044D\u0442\u043E \u0441\u0432\u0435\u0442 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0441\u0442\u0438.
    \u0415\u0433\u043E \u043E\u0442\u043B\u0438\u0447\u0438\u0435\L\u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u043E\u043D \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442
    \u0440\u0430\u0437\u0443\u043C \u0438 \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0440\u043E\u0431\u0443\u0436\u0434\u0430\u0435\u0442
    \u0435\u0433\u043E \u0434\u0443\u0448\u0443 \u0438 \u0441\u043E\u0432\u0435\u0441\u0442\u044C,
    \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u0412
    \u0441\u0435\u0440\u0434\u0446\u0435 \u0438 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0438
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u043E\u043B\u0436\u0435\u043D\L\u0441\u0438\u044F\u0442\u044C
    \u0442\u0430\u043A\u043E\u0439 \u0441\u0432\u0435\u0442 \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0441\u0442\u0438
    \u2014 \u043F\u043E\u0431\u0443\u0436\u0434\u0430\u044F \u043A \u0434\u043E\u0431\u0440\u044B\u043C
    \u0434\u0435\u043B\u0430\u043C\L\u0438 \u043F\u0440\u0438\u0437\u044B\u0432\u0430\u044F
    \u0436\u0438\u0442\u044C \u0441 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C
    \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
