  m_text: "\u041C\u0435\u0447\u0442\u0430 \u043E\_\u041D\u043E\u0432\u043E\u043C
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0435 \u0438\_\u0435\u0451\_\u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F\_\u2014
    \u044D\u0442\u043E\_\u043D\u0435\_\u043F\u0440\u043E\u0441\u0442\u043E \u0436\u0435\u043B\u0430\u043D\u0438\u0435
    \u0438\u043B\u0438\_\u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0435, \u0430\_\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C,
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u043D\u0430\u044F \u043D\u0430\_\u0433\u043B\u0443\u0431\u0438\u043D\u043D\u044B\u0445
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0435\u0434\u043F\u043E\u0441\u044B\u043B\u043A\u0430\u0445.
    \u042D\u0442\u0430\_\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0435\u043D\u0430
    \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u0439 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E-\u043F\u0440\u0430\u0432\u043E\u0432\u043E\u0439,
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0438\_\u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439 \u0432\_\u0441\u0442\u0440\u0430\u043D\u0435,
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432\u0435\u043A\u043E\u0432\u044B\u043C \u0447\u0430\u044F\u043D\u0438\u044F\u043C
    \u0438\_\u0443\u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u044F\u043C
    \u043D\u0430\u0448\u0435\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0430, \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0435\u0433\u043E\_\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u043C.\n\n\u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043A\u043E\u0440\u043D\u0438 \u0438\_\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C\n\u041D\u0430\u0448\u0430
    \u0432\u0435\u043B\u0438\u043A\u0430\u044F \u0441\u0442\u0440\u0430\u043D\u0430
    \u043D\u0430\_\u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u0439
    \u0431\u044B\u043B\u0430 \u0446\u0435\u043D\u0442\u0440\u043E\u043C \u043C\u0438\u0440\u043E\u0432\u043E\u0439
    \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438, \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u044C\u044E
    \u043D\u0430\u0443\u043A\u0438 \u0438\_\u043A\u0443\u043B\u044C\u0442\u0443\u0440\u044B,
    \u043C\u043E\u0441\u0442\u043E\u043C \u043C\u0435\u0436\u0434\u0443\_\u0412\u043E\u0441\u0442\u043E\u043A\u043E\u043C
    \u0438\_\u0417\u0430\u043F\u0430\u0434\u043E\u043C. \u0423\u0437\u0431\u0435\u043A\u0441\u043A\u0430\u044F
    \u0437\u0435\u043C\u043B\u044F \u0434\u0430\u043B\u0430 \u043C\u0438\u0440\u0443
    \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u043C\u044B\u0441\u043B\u0438\u0442\u0435\u043B\u0435\u0439\_\u2014
    \u0410\u0432\u0438\u0446\u0435\u043D\u043D\u0443, \u0410\u043B\u044C-\u0425\u043E\u0440\u0435\u0437\u043C\u0438,
    \u0410\u043B\u044C-\u0411\u0438\u0440\u0443\u043D\u0438, \u0423\u043B\u0443\u0433\u0431\u0435\u043A\u0430,
    \u0410\u043B\u0438\u0448\u0435\u0440\u0430 \u041D\u0430\u0432\u043E\u0438, \u0438\u043C\u0435\u043D\u0430
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0430\u0432\u0435\u0447\u043D\u043E
    \u0432\u043F\u0438\u0441\u0430\u043D\u044B \u0432\_\u0437\u043E\u043B\u043E\u0442\u0443\u044E
    \u043A\u043D\u0438\u0433\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439
    \u0446\u0438\u0432\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438.\n\n\u0412\u044B\u0437\u043E\u0432\u044B
    \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438\n\u041D\u0430\_\u0440\u0443\u0431\u0435\u0436\u0435
    XXI \u0432\u0435\u043A\u0430 \u043D\u0430\u0448\u0430 \u0441\u0442\u0440\u0430\u043D\u0430
    \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0430\u0441\u044C \u0441\_\u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
    \u0432\u044B\u0437\u043E\u0432\u0430\u043C\u0438: \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0441\u0442\u044C\u044E
    \u043E\u0442\_\u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E \u043C\u0438\u0440\u0430,
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0434\u0435\u043C\u043E\u043A\u0440\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0438\u043D\u0441\u0442\u0438\u0442\u0443\u0442\u043E\u0432, \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F\u043C\u0438
    \u043F\u0440\u0430\u0432 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0440\u0440\u0443\u043F\u0446\u0438\u0435\u0439
    \u0438\_\u043D\u0435\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u043E\u0434\u0435\u043B\u044C\u044E. \u0412\u0441\u0435\_\u044D\u0442\u043E\_\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u043E
    \u043A\u0430\u0440\u0434\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439
    \u0432\_\u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E-\u043F\u0440\u0430\u0432\u043E\u0432\u043E\u0439,
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0438\_\u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0441\u0444\u0435\u0440\u0430\u0445.\n\n\u041A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F
    \u041D\u043E\u0432\u043E\u0433\u043E \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430\n\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u041D\u043E\u0432\u043E\u0433\u043E
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u043D\u0443\u044E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439
    \u0432\u043E\_\u0432\u0441\u0435\u0445 \u0441\u0444\u0435\u0440\u0430\u0445 \u0436\u0438\u0437\u043D\u0438
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430. \u042D\u0442\u043E\_\u044D\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u043D\u044B\u0439,
    \u043F\u043E\u044D\u0442\u0430\u043F\u043D\u044B\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441
    \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0430\u0446\u0438\u0438 \u0441\_\u043E\u043F\u043E\u0440\u043E\u0439
    \u043D\u0430\_\u043B\u0443\u0447\u0448\u0438\u0435 \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0438\_\u043F\u0435\u0440\u0435\u0434\u043E\u0432\u043E\u0439
    \u043C\u0438\u0440\u043E\u0432\u043E\u0439 \u043E\u043F\u044B\u0442, \u0433\u0434\u0435\_\u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u044B\u0441\u0448\u0435\u0439
    \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E, \u0430\_\u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
    \u0441\u043B\u0443\u0436\u0438\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u043C
    \u0433\u0440\u0430\u0436\u0434\u0430\u043D.\n\L"
