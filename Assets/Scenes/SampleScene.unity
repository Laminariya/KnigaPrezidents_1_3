--- !u!114 &1575851893
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1575851887}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xABDavlat inson uchun\xBB tamoyili\r\nYangi O'zbekistonda \xABDavlat
    inson uchun\xBB tamoyili islohotlarning ustuvor yo'nalishiga aylandi, bu fuqarolarning
    davlatga xizmat qilish tushunchasidan davlatning har bir fuqaroga xizmat qilish
    modeliga tubdan o'zgarishni anglatadi. Barcha davlat qarorlari bitta mezon orqali
    o'tishi kerak: ular fuqarolarning hayot sifatini yaxshilashga va ularning huquqlarini
    himoya qilishga yordam beradimi.\r\n\r\nXalqaro tan olish\r\nBu yo'nalish butun
    dunyoda zamonaviy davlat qurilishining eng demokratik tamoyillariga muvofiq deb
    tan olingan. O'zbekiston milliy xususiyatlarini hisobga olgan holda dunyodagi
    eng yaxshi amaliyotlarni ijodiy ravishda o'zlashtirgan holda, universal insoniy
    qadriyatlarni o'z ichiga olgan madaniy millatlar oilasiga integratsiyalashmoqda\r\n\r\nIslohotlarning
    yakuniy maqsadi\r\nDavlat siyosatining asosiy maqsadi - inson qadr-qimmatini,
    manfaatlarini, huquq va erkinliklarini ta'minlashdir. Davlatning barcha sa'y-harakatlari
    har bir fuqaroning o'zini to'liq ro'yobga chiqarishi uchun shart-sharoitlar yaratishga,
    inson qadr-qimmatini kamsitish mumkin bo'lmagan jamiyatda xavfsizlik va farovonlikni
    ta'minlashga qaratilgan."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d673168cf8d12c847b911bc6e613b387, type: 2}
  m_sharedMaterial: {fileID: 3493197763580223026, guid: d673168cf8d12c847b911bc6e613b387, type: 2}
