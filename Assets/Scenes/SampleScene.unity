    \u0438\_\u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0441\u0444\u0435\u0440\u0430\u0445.\n\n\u041A\u043E\u043D\u0446\u0435\u043F\u0446\u0438\u044F
    \u041D\u043E\u0432\u043E\u0433\u043E \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430\n\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
