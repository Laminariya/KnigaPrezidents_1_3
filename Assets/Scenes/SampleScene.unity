  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u043E\u0432\u043E\u0435 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u0435\n\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u0441\u043B\u0443\u0436\u0438\u0442
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E\u0433\u043E
    \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0449\u0435\u0433\u043E
    \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0430 \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043D\u043E\u0432\u043E\u0433\u043E \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u044B\u0448\u043B\u0435\u043D\u0438\u044F \u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439. \u0412 \u0446\u0435\u043D\u0442\u0440\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0431\u043B\u0430\u0433\u0438\u0445
    \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u0439 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u0441\u0435\u043C\u044C\u0438
    \u043A \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u0438 \u043F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u044E\u0449\u0435\u0439
    \u0436\u0438\u0437\u043D\u0438,\L\u0430 \u0433\u043B\u0430\u0432\u043D\u044B\u043C
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043E\u043C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0439 \u0440\u043E\u0441\u0442
    \u0443\u0440\u043E\u0432\u043D\u044F \u0436\u0438\u0437\u043D\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F.\n\L\u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u044B\u0435
    \u0440\u0435\u0444\u043E\u0440\u043C\u044B\n\u041A 2030 \u0433\u043E\u0434\u0443
    \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0438\u0447\u044C
    \u0430\u043C\u0431\u0438\u0446\u0438\u043E\u0437\u043D\u044B\u0445 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439: \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
    \u0433\u043E\u0434\u043E\u0432\u043E\u0433\u043E \u0440\u043E\u0441\u0442\u0430
    \u0434\u043E 6,3-6,5%, \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435
    \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0439\L\u0434\u043E
    8,0-8,5% \u0412\u0412\u041F, \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435
    \u043E\u0431\u044A\u0435\u043C\u0430 \u044D\u043A\u0441\u043F\u043E\u0440\u0442\u0430
    \u0432 9,0-10,0% \u043E\u0442 \u0412\u0412\u041F. \u0421\u043D\u0438\u0436\u0435\u043D\u0438\u0435
    \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043D\u044B\u0445 \u0441\u0442\u0430\u0432\u043E\u043A
    \u0441\u0442\u0430\u043D\u0435\u0442 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u043C
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u043E\u043C \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439 \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u0435\u043A\u0442\u043E\u0440\u044B \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438.\n\n\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430\n\u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0447\u0430\u0441\u0442\u043D\u043E\u0433\u043E \u0441\u0435\u043A\u0442\u043E\u0440\u0430
    \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0430 \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u043E\u0441\u0442\u0430. \u0420\u0430\u0441\u0448\u0438\u0440\u044F\u044E\u0442\u0441\u044F
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
    \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u0439,
    \u0432\u043A\u043B\u044E\u0447\u0430\u044F \u043B\u044C\u0433\u043E\u0442\u043D\u043E\u0435
    \u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u0438\u0435 \u043C\u0430\u043B\u043E\u0433\u043E
    \u0431\u0438\u0437\u043D\u0435\u0441\u0430\L\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
    \xAB\u0421\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0440\u0435\u0435\u0441\u0442\u0440 \u0433\u0440\u0430\u0436\u0434\u0430\u043D\xBB
    \u0434\u043B\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u044F
    \u0434\u043E\u0441\u0442\u0443\u043F\u0430 \u043A \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u044B\u043C
    \u0440\u0435\u0441\u0443\u0440\u0441\u0430\u043C.\L\n\u0426\u0438\u0444\u0440\u043E\u0432\u0438\u0437\u0430\u0446\u0438\u044F
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438\n\u041E\u0441\u043E\u0431\u043E\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0443\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0435\u043D\u0438\u044E \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0445
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439\L\u0432 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u0444\u0435\u0440\u0443, \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E
    IT-\u043F\u0440\u0435\u0434\u043F\u0440\u0438\u044F\u0442\u0438\u0439 \u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439
    \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438. \u0426\u0438\u0444\u0440\u043E\u0432\u044B\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044E\u0442
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E \u0443\u0434\u043E\u0431\u043D\u043E\u0439
    \u0441\u0440\u0435\u0434\u044B\L\u0434\u043B\u044F \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u044B\u043D\u043A\u0430 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0438\u043D\u043D\u043E\u0432\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0441\u0442\u0430\u0440\u0442\u0430\u043F\u043E\u0432 \u0447\u0435\u0440\u0435\u0437
    \u0442\u0435\u0445\u043D\u043E\u043F\u0430\u0440\u043A\u0438 \u0438 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0446\u0435\u043D\u0442\u0440\u044B.\n"
