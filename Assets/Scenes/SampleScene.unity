  m_text: "\u041E\u0441\u043D\u043E\u0432\u043E\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0438\u0435
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B\n\u0412\u043D\u0435\u0448\u043D\u044F\u044F
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0430 \u041D\u043E\u0432\u043E\u0433\u043E
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441 \u0432\u0441\u0435\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C\L\u0443\u0447\u0435\u0442\u043E\u043C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u0432 \u043D\u0430\u0440\u043E\u0434\u0430
    \u0438 \u0420\u043E\u0434\u0438\u043D\u044B. \u0423\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u043E\u0431\u043E\u0440\u043E\u043D\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438\L\u0441\u0442\u0440\u0430\u043D\u044B
    \u0438 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430 \u0412\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445
    \u0421\u0438\u043B \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432\u0430\u0436\u043D\u0435\u0439\u0448\u0438\u043C
    \u0443\u0441\u043B\u043E\u0432\u0438\u0435\u043C \u043D\u0435\u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0433\u0440\u0430\u043D\u0438\u0446, \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0432 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435,\L\u043C\u0438\u0440\u043D\u043E\u0439
    \u0436\u0438\u0437\u043D\u0438 \u043D\u0430\u0440\u043E\u0434\u0430.\n\L\u0412\u043E\u0435\u043D\u043D\u0430\u044F
    \u0434\u043E\u043A\u0442\u0440\u0438\u043D\u0430\n\u0412\u043E\u0435\u043D\u043D\u0430\u044F
    \u0434\u043E\u043A\u0442\u0440\u0438\u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043E\u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0435 \u0432\u043E\u0435\u043D\u043D\u043E\u0439
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438 \u0441 \u043E\u0442\u043A\u0430\u0437\u043E\u043C
    \u043E\u0442 \u0443\u0447\u0430\u0441\u0442\u0438\u044F \u0432 \u0432\u043E\u0435\u043D\u043D\u044B\u0445
    \u0431\u043B\u043E\u043A\u0430\u0445 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
    \u0430\u0440\u043C\u0438\u0438, \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
    \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439 \u043F\u0440\u0438
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0438 \u043C\u0438\u0440\u043D\u044B\u0445
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u0432 \u0432\u043D\u0435\u0448\u043D\u0435\u0439
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0438.\n\n\u0420\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0430\n\u0421\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044F
    \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439
    \u0441\u043E \u0441\u0442\u0440\u0430\u043D\u0430\u043C\u0438 \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0410\u0437\u0438\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430\L\u043D\u0430
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u0445 \u0434\u043E\u0431\u0440\u043E\u0441\u043E\u0441\u0435\u0434\u0441\u0442\u0432\u0430,
    \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0433\u043E \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
    \u0441\u0443\u0432\u0435\u0440\u0435\u043D\u0438\u0442\u0435\u0442\u0430, \u043D\u0435\u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u0432\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0435 \u0434\u0435\u043B\u0430
    \u0438 \u043C\u0438\u0440\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
    \u0441\u043F\u043E\u0440\u043E\u0432. \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D
    \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043B\u043E\u043A\u043E\u043C\u043E\u0442\u0438\u0432\u043E\u043C
    \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438
    \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0432\u044F\u0437\u0435\u0439.\n\n\u041C\u043D\u043E\u0433\u043E\u0432\u0435\u043A\u0442\u043E\u0440\u043D\u0430\u044F
    \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u044F\n\u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
    \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0440\u0430\u0432\u043D\u043E\u043F\u0440\u0430\u0432\u043D\u044B\u0445 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0439\L\u0441\u043E
    \u0432\u0441\u0435\u043C\u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438
    \u043C\u0438\u0440\u043E\u0432\u044B\u043C\u0438 \u0434\u0435\u0440\u0436\u0430\u0432\u0430\u043C\u0438,
    \u0438\u0437\u0431\u0435\u0433\u0430\u044F \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438. \u0410\u043A\u0442\u0438\u0432\u043D\u043E
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0443\u0447\u0430\u0441\u0442\u0438\u0435
    \u0432 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u041E\u041E\u041D,\L\u0428\u041E\u0421, \u0421\u041D\u0413, \u041E\u0418\u0421
    \u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439.\n\n\u0421\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
    \u0443\u0433\u0440\u043E\u0437\u044B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\n\u041E\u0441\u043E\u0431\u043E\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0443\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u0431\u043E\u0440\u044C\u0431\u0435 \u0441 \u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0437\u043C\u043E\u043C
    \u0438 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0438\u0437\u043C\u043E\u043C
    \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0432\u0435\u043D\u0442\u0438\u0432\u043D\u044B\u0435
    \u043C\u0435\u0440\u044B, \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B \u0438 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0435
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E.
    \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043A\u0438\u0431\u0435\u0440\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
    \u0438 \u0440\u0435\u0448\u0435\u043D\u0438\u044F \u0442\u0440\u0430\u043D\u0441\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0445
    \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C.\n\n\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u044F\n\u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0440\u0435\u0441\u0443\u0440\u0441\u044B \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
    \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u0438\u043D\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430 \u0441\u0442\u0440\u0430\u043D\u044B,
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0431\u043B\u0430\u0433\u043E\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0433\u043E
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u043C\u0438\u0434\u0436\u0430 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F
    \u0442\u043E\u0440\u0433\u043E\u0432\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u0432\u044F\u0437\u0435\u0439. \u041E\u0441\u043E\u0431\u043E\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u0443\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u0434\u0438\u0432\u0435\u0440\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u0438
    \u0432\u043D\u0435\u0448\u043D\u0435\u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
    \u0441\u0432\u044F\u0437\u0435\u0439 \u0438 \u043F\u043E\u0438\u0441\u043A\u0443
    \u043D\u043E\u0432\u044B\u0445 \u0440\u044B\u043D\u043A\u043E\u0432 \u0441\u0431\u044B\u0442\u0430.\L\n\u0413\u0443\u043C\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u0430\u044F
    \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u044F\n\u0410\u043A\u0442\u0438\u0432\u043D\u043E
    \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0443\u0437\u0431\u0435\u043A\u0441\u043A\u0430\u044F
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0430 \u0438 \u044F\u0437\u044B\u043A
    \u0432 \u043C\u0438\u0440\u0435 \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u044B\u0445 \u0446\u0435\u043D\u0442\u0440\u043E\u0432,
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0442\u0443\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B\u0430 \u0438 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0435
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043D\u044B\u0435 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u044F.
    \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B
    \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u043E\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435
    \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439.\n\n\u041C\u0438\u0440\u043D\u044B\u0435
    \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u044B\n\u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D
    \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u043A\u0430\u043A \u043C\u0438\u0440\u043E\u0442\u0432\u043E\u0440\u0435\u0446
    \u0432 \u0440\u0435\u0433\u0438\u043E\u043D\u0435, \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432
    \u0438 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u0433\u0443\u043C\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u0443\u044E
    \u043F\u043E\u043C\u043E\u0449\u044C. \u0421\u0442\u0440\u0430\u043D\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0435
    \u0443\u0441\u0438\u043B\u0438\u044F \u043F\u043E \u0440\u0430\u0437\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044E,
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044E \u0437\u043E\u043D, \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445
    \u043E\u0442 \u043E\u0440\u0443\u0436\u0438\u044F \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0433\u043E
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F, \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E
    \u0437\u0430 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435\u043C
    \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0439.\n"
