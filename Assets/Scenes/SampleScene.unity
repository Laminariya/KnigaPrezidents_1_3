--- !u!114 &830755186
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 830755181}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a3e34b07c94be9c48bdc24e93935fffe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textJuicer: {fileID: 0}
  textList:
  - "Kitobning muqaddima qismida Yangi O\u02BBzbekiston orzusi, uni barpo etish \u2013
    bu shunchaki xohish-istak, subyektiv hodisa emas, balki tub tarixiy asoslarga
    ega bo\u2018lgan, mamlakatimizda mavjud siyosiy-huquqiy, ijtimoiy-iqtisodiy,
    ma`naviy-ma`rifiy vaziyatning o\u2018zi taqozo etayotgan, xalqimizning asriy
    orzu-intilishlariga mos, uning milliy manfaatlariga to\u2018la javob beradigan
    obyektiv zarurat ekani\_ bayon etilgan."
  - "\u0412\u043E\_\u0432\u0432\u0435\u0434\u0435\u043D\u0438\u0438 \u043A\_\u043A\u043D\u0438\u0433\u0435
    \u0438\u0437\u043B\u043E\u0436\u0435\u043D\u043E, \u0447\u0442\u043E\_\u043C\u0435\u0447\u0442\u0430
    \u043E\_\u041D\u043E\u0432\u043E\u043C \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0435
    \u0438\_\u0435\u0451\_\u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435
    \u0432\_\u0436\u0438\u0437\u043D\u044C\_\u2014 \u044D\u0442\u043E\_\u043D\u0435\_\u043F\u0440\u043E\u0441\u0442\u043E
    \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0438\u043B\u0438\_\u0441\u0443\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u044F\u0432\u043B\u0435\u043D\u0438\u0435, \u0430\_\u043E\u0431\u044A\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C,
    \u0438\u043C\u0435\u044E\u0449\u0430\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435
    \u0438\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043E\u0441\u043D\u043E\u0432\u044B,
    \u0434\u0438\u043A\u0442\u0443\u0435\u043C\u0430\u044F \u0441\u0430\u043C\u043E\u0439
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439 \u0432\_\u043D\u0430\u0448\u0435\u0439
    \u0441\u0442\u0440\u0430\u043D\u0435 \u043F\u043E\u043B\u0438\u0442\u0438\u043A\u043E-\u043F\u0440\u0430\u0432\u043E\u0432\u043E\u0439,
    \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439,
    \u0434\u0443\u0445\u043E\u0432\u043D\u043E-\u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439, \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0430\u044F
    \u0432\u0435\u043A\u043E\u0432\u044B\u043C \u043C\u0435\u0447\u0442\u0430\u043C
    \u0438\_\u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u044F\u043C \u043D\u0430\u0448\u0435\u0433\u043E
    \u043D\u0430\u0440\u043E\u0434\u0430, \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0449\u0430\u044F \u0435\u0433\u043E\_\u043D\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u043C."
--- !u!114 &830755187
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 830755181}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0413\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u044B\u0437\u043E\u0432\u044B\n\u041A
    \u043A\u043E\u043D\u0446\u0443 XX \u0438 \u043D\u0430\u0447\u0430\u043B\u0443
    XXI \u0432\u0435\u043A\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u043E\u0441\u044C \u0441 \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E\u043C
    \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C: \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
    \u043A\u043B\u0438\u043C\u0430\u0442\u0430, \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u043C
    \u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0437\u043C\u043E\u043C, \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C\u044E,
    \u043A\u0438\u0431\u0435\u0440-\u0443\u0433\u0440\u043E\u0437\u0430\u043C\u0438,
    \u043C\u0438\u0433\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430\u043C\u0438 \u0438 \u043F\u0430\u043D\u0434\u0435\u043C\u0438\u044F\u043C\u0438.
    \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u043F\u043E\u0438\u0441\u043A\u0438
    \u0440\u0435\u0448\u0435\u043D\u0438\u0439 \u2014 \u043F\u0443\u0442\u044C \u043A
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044E \u043C\u0438\u0440\u0430,
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u0438 \u0438
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u0430.\n\n\u041F\u043E\u0437\u0438\u0446\u0438\u044F
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D\u0430\n\u041D\u043E\u0432\u044B\u0439
    \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u0443\u0441\u0438\u043B\u0438\u044F\u0445 \u043F\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044E
    \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u043E\u0431\u043B\u0435\u043C,
    \u0438\u0441\u0445\u043E\u0434\u044F \u0438\u0437 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
    \u0432 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u043C \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u043C
    \u043C\u0438\u0440\u0435 \u043D\u0438 \u043E\u0434\u043D\u043E \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u043E
    \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0440\u0435\u0448\u0438\u0442\u044C
    \u044D\u0442\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443.
    \u0422\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u0440\u0435\u0437 \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0435
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445
    \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.\n\n\u0411\u043E\u0440\u044C\u0431\u0430
    \u0441 \u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0437\u043C\u043E\u043C\n\u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u0430\u043D\u0442\u0438\u0442\u0435\u0440\u0440\u043E\u0440\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0443\u0441\u0438\u043B\u0438\u044F\u0445, \u0441\u0447\u0438\u0442\u0430\u044F,
    \u0447\u0442\u043E \u0431\u043E\u0440\u044C\u0431\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
    \u0432\u0435\u0441\u0442\u0438\u0441\u044C \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441\u0438\u043B\u043E\u0432\u044B\u043C\u0438 \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438,\L\u043D\u043E
    \u0438 \u0447\u0435\u0440\u0435\u0437 \u0443\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u0435
    \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0445 \u043F\u0440\u0438\u0447\u0438\u043D:
    \u0431\u0435\u0434\u043D\u043E\u0441\u0442\u0438, \u043D\u0435\u0433\u0440\u0430\u043C\u043E\u0442\u043D\u043E\u0441\u0442\u0438,\L\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0438
    \u0438 \u0438\u0434\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0438\u0437\u043C\u0430.\n\n\u042D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B\n\u041E\u0441\u043E\u0431\u043E\u0435
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0443\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u0440\u0435\u0448\u0435\u043D\u0438\u044E \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u0410\u0440\u0430\u043B\u044C\u0441\u043A\u043E\u0433\u043E \u043C\u043E\u0440\u044F
    \u0438 \u0431\u043E\u0440\u044C\u0431\u0435\L\u0441 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0435\u043C
    \u043A\u043B\u0438\u043C\u0430\u0442\u0430. \u0423\u0437\u0431\u0435\u043A\u0438\u0441\u0442\u0430\u043D
    \u0440\u0435\u0430\u043B\u0438\u0437\u0443\u0435\u0442 \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044E
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043A \xAB\u0437\u0435\u043B\u0435\u043D\u043E\u0439
    \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0435\xBB, \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442
    \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u043C\u044B\u0435
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u0438 \u0432\u043D\u0435\u0434\u0440\u044F\u0435\u0442 \u044D\u043A\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438
    \u0447\u0438\u0441\u0442\u044B\u0435 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438.\n\n\u041C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0435
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E\n\u0421\u0442\u0440\u0430\u043D\u0430
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C \u041E\u041E\u041D \u0432 \u0440\u0435\u0448\u0435\u043D\u0438\u0438
    \u0433\u043B\u043E\u0431\u0430\u043B\u044C\u043D\u044B\u0445 \u043F\u0440\u043E\u0431\u043B\u0435\u043C
    \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043C\u0435\u0436\u0434\u0443\u043D\u0430\u0440\u043E\u0434\u043D\u044B\u0445
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u0439. \u0420\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0440\u0435\u0433\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0432 \u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0410\u0437\u0438\u0438
    \u0438 \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u044F\u044F
    \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u043E\u0432 \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0433\u043E
    \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u0438 \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439
    \u0432\u044B\u0433\u043E\u0434\u044B.\n"
