  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "XX asrning oxiri va XXI asrning boshlariga kelib insoniyat ko'plab umumbashariy
    muammolarga duch keldi. Ushbu muammolar va ularning yechimlariga doir masalalar
    bugungi kunda nihoyatda dolzarb bo\u02BBlib qolmoqda.\nHamkorlikda izlanish va
    o'zaro manfaatli qarorlar qabul qilish - tinchlik, barqarorlik va taraqqiyotni
    ta'minlash singari ezgu maqsadlarimizga erishish imkonini beradi.\n"
