--- !u!114 &987019558
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 987019552}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ma\u2019naviy nur\nInsoniyat olamida inson aqli va fikrlashini yoritadigan,
    ruhi va vijdonini uyg'otadigan, insonlik tuyg'usini kuchaytiradigan buyuk chiroq
    - ma'naviyat nuri bor. Har bir vatandoshning yuragida shunday nur porlashi kerak,
    yaxshilik va yuksak mas'uliyatlarga undashi kerak.\n\nTarixiy ildizlar\nO'zbek
    xalqi asrlar davomida chuqur ma'naviy an'analari bilan mashhur bo'lgan. Buyuk
    mutafakkirlar - Ibn Sino, Al-Xorazmiy, Mirzo Ulug'bek, Alisher Navoiy - ma'naviyat
    va bilimlarning uyg'un uyg'unligiga namuna bo'lib, jamiyatni rivojlantirish uchun
    asos yaratdilar.\n\nMilliy o\u2019ziga xoslik\nMa'naviy qadriyatlar globallashuv
    davrida milliy o'ziga xoslikni saqlab qolishda muhim rol o'ynaydi. O'zbek ma'naviyati
    mehmondo'stlik, kattalarni hurmat qilish, kichiklarga g'amxo'rlik qilish va adolatga
    intilish bilan ajralib turadi, jahon madaniyatining eng yaxshi yutuqlariga ochiq
    bo'lib qoladi.\n\nYoshlarni tarbiyalash\nMaxsus dasturlar, yoshlar tashkilotlarini
    qo'llab-quvvatlash va ko'ngillilar harakatini rivojlantirish orqali yosh avlodning
    ma'naviy tarbiyasiga alohida e'tibor qaratilmoqda. Yoshlarga abadiy ma'naviy
    qadriyatlarga asoslangan to'g'ri hayot yo'lini topishlariga yordam berish muhimdir.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d673168cf8d12c847b911bc6e613b387, type: 2}
  m_sharedMaterial: {fileID: 3493197763580223026, guid: d673168cf8d12c847b911bc6e613b387, type: 2}
